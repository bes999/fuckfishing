rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Фото профиля — один файл на пользователя (перезаписывается). Читать
    // может любой, кто вошёл в приложение (только они и попадают на
    // страницу профиля кого-то ещё, см. firestore.rules); писать — только
    // сам владелец, и только реальную картинку не крупнее 5 МБ (реальный
    // размер после сжатия на клиенте — сотни КБ, лимит на всякий случай).
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
