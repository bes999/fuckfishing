rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isOrganizer() {
      return isMember() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'organizer';
    }

    // Разрешено пройти онбординг, только если email из Firebase Auth
    // токена уже есть в аллоулисте /invites — заполняется существующими
    // участниками через "Пригласить" (modules/members/render.js).
    function isInvited() {
      return isSignedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    // Организатор КОНКРЕТНОЙ поездки (её создатель, trip.ownerId) — не
    // путать с isOrganizer() выше, это app-wide profile.role, другое поле
    // с другим смыслом (см. modules/auth/index.js).
    function isTripOrganizer(tripId) {
      return isMember() &&
        get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
    }

    // Одноразовый публичный маркер "кто-то уже прошёл онбординг" —
    // используется вместо чтения members.limit(1) для решения "я первый?",
    // потому что read на /members и так требует isMember()/isInvited(),
    // а самый первый человек в пустой базе не может быть ни тем, ни другим
    // (иначе никто и никогда не смог бы стать первым организатором вообще —
    // до этого документа completeOnboarding() тихо проваливал свою же
    // "я первый?" проверку permission-denied'ом и никогда не назначал
    // организатора). Существование этого документа само по себе не
    // секрет, поэтому read открыт всем; create — только пока документа
    // ещё нет (значит ставит его ровно один раз, самый первый онбординг).
    match /system/bootstrap {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/system/bootstrap);
      allow update, delete: if false;
    }

    match /members/{uid} {
      // Читать список нужно даже до онбординга — completeOnboarding()
      // (modules/auth/index.js) проверяет "я первый пользователь?" ДО
      // того как свой профиль создан.
      allow read:   if isMember() || isInvited();
      // Первый человек в пустой базе (system/bootstrap ещё не существует)
      // может пройти онбординг без приглашения — иначе бутстрап приложения
      // с нуля невозможен вообще никак через UI.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        (isInvited() || !exists(/databases/$(database)/documents/system/bootstrap));
      allow update: if isMember() && (request.auth.uid == uid || isOrganizer());
      allow delete: if isMember() && isOrganizer();
    }

    match /invites/{email} {
      allow read:            if isMember();
      allow create, delete:  if isMember();
      allow update:          if false;
    }

    match /trips/{tripId} {
      allow read, write: if isMember();

      // Удалить чужую запись расхода/улова может только организатор ЭТОЙ
      // поездки — свою запись (createdBy == себя) может удалить любой.
      // Редактирование/чтение остаются открытыми всем участникам, как и
      // раньше — здесь закрывается только delete.
      match /expenses/{docId} {
        allow read, create, update: if isMember();
        allow delete: if isMember() &&
          (resource.data.createdBy == request.auth.uid || isTripOrganizer(tripId));
      }
      match /catches/{docId} {
        allow read, create, update: if isMember();
        allow delete: if isMember() &&
          (resource.data.createdBy == request.auth.uid || isTripOrganizer(tripId));
      }

      // Firestore объединяет правила из ВСЕХ подходящих match-блоков через
      // OR, а не берёт самый специфичный — этот wildcard тоже совпадает с
      // путями expenses/catches, поэтому явно исключаем их отсюда, иначе
      // его allow write перекрывает более узкое правило на delete выше.
      match /{subcollection}/{docId} {
        allow read, write: if isMember() && !(subcollection in ['expenses', 'catches']);
      }
    }

    // Вложенное правило выше (match /trips/{tripId} { match /catches/{docId} })
    // действует только на запросы к конкретной поездке — collectionGroup-
    // запрос по всем catches сразу (см. CatchesFirebase.listenAll, нужен
    // для агрегированной статистики на Главной/в "Планах") требует
    // отдельного рекурсивного правила, иначе Firestore отвечает
    // permission-denied даже при isMember() == true. Запись сюда не нужна —
    // пишут всегда по конкретному пути trips/{tripId}/catches, это уже
    // покрыто правилом выше.
    match /{path=**}/catches/{docId} {
      allow read: if isMember();
    }

    match /menu/{tripId}        { allow read, write: if isMember(); }
    match /shopping/{tripId}    { allow read, write: if isMember(); }
    match /bar_reviews/{id}     { allow read, write: if isMember(); }
    match /recipes_reviews/{id} { allow read, write: if isMember(); }

    // Рецепты, добавленные участниками через интерфейс (помимо встроенного
    // каталога, который зашит прямо в код и не хранится в Firestore) —
    // удалить может только автор.
    match /recipes_custom/{id} {
      allow read, create, update: if isMember();
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;
    }

    // Личные списки снаряги под конкретную поездку — видны всем участникам
    // (как расходы/улов), но создавать/менять/удалять может только владелец.
    match /gear_trip_snapshots/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
