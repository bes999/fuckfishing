rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isOrganizer() {
      return isMember() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'organizer';
    }

    // Разрешено пройти онбординг, только если email из Firebase Auth
    // токена уже есть в аллоулисте /invites — заполняется существующими
    // участниками через "Пригласить" (modules/members/render.js).
    // email_verified обязателен — Firebase НЕ проверяет владение почтой при
    // регистрации по паролю, token.email можно поставить любым, включая
    // чужой приглашённый (email не секрет). Без этой проверки посторонний,
    // узнавший приглашённый адрес, мог зарегистрироваться им и пройти
    // онбординг, не имея доступа к самой почте. У Google-входа
    // email_verified true всегда (OAuth уже подтверждает владение), у
    // email/pass — только после перехода по ссылке из письма (см.
    // modules/auth/index.js registerEmail). Реальная дыра, найдена внешним
    // ревью 2026-09-27. Не влияет на уже онбордившихся — isMember() ниже
    // на email_verified не смотрит вообще.
    function isInvited() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    // Организатор КОНКРЕТНОЙ поездки (её создатель, trip.ownerId) — не
    // путать с isOrganizer() выше, это app-wide profile.role, другое поле
    // с другим смыслом (см. modules/auth/index.js).
    function isTripOrganizer(tripId) {
      return isMember() &&
        get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
    }

    // Одноразовый публичный маркер "кто-то уже прошёл онбординг" —
    // используется вместо чтения members.limit(1) для решения "я первый?",
    // потому что read на /members и так требует isMember()/isInvited(),
    // а самый первый человек в пустой базе не может быть ни тем, ни другим
    // (иначе никто и никогда не смог бы стать первым организатором вообще —
    // до этого документа completeOnboarding() тихо проваливал свою же
    // "я первый?" проверку permission-denied'ом и никогда не назначал
    // организатора). Существование этого документа само по себе не
    // секрет, поэтому read открыт всем; create — только пока документа
    // ещё нет (значит ставит его ровно один раз, самый первый онбординг).
    match /system/bootstrap {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/system/bootstrap);
      allow update, delete: if false;
    }

    match /members/{uid} {
      // Читать список нужно даже до онбординга — completeOnboarding()
      // (modules/auth/index.js) проверяет "я первый пользователь?" ДО
      // того как свой профиль создан.
      allow read:   if isMember() || isInvited();
      // Первый человек в пустой базе (system/bootstrap ещё не существует)
      // может пройти онбординг без приглашения — иначе бутстрап приложения
      // с нуля невозможен вообще никак через UI.
      // Роль 'organizer' (суперадмин) при создании — только самому первому
      // человеку в пустой базе, иначе любой приглашённый выдал бы её себе.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        (isInvited() || !exists(/databases/$(database)/documents/system/bootstrap)) &&
        (request.resource.data.get('role', 'member') != 'organizer' ||
         !exists(/databases/$(database)/documents/system/bootstrap));
      // Свой профиль правит сам, но не свою роль — её меняет только суперадмин.
      allow update: if isMember() && (isOrganizer() ||
        (request.auth.uid == uid &&
         request.resource.data.get('role', 'member') == resource.data.get('role', 'member')));
      allow delete: if isMember() && isOrganizer();
    }

    // Код привязки Telegram — раньше жил прямо в members/{uid}, который
    // читают ВСЕ участники (isMember()); пока код действует (15 минут), его
    // можно было подсмотреть и привязать чужой профиль к своему Telegram.
    // Реальная дыра, найдена внешним ревью 2026-09-27. Теперь код — id
    // отдельного документа, и читать эту коллекцию нельзя НИКОМУ с клиента
    // (клиент и не должен — код он и так знает, сам его сгенерировал), только
    // создать свой и удалить свой же (отмена). Бот проверяет код прямым
    // просмотром по id через Admin SDK, который и так в обход всех правил.
    match /telegram_link_codes/{code} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow read, update: if false;
    }

    match /invites/{email} {
      allow read:            if isMember();
      allow create, delete:  if isMember();
      allow update:          if false;
    }

    match /trips/{tripId} {
      allow read: if isMember();
      // Создать/редактировать может любой участник, как раньше — только
      // удалить саму поездку насовсем ограничено её создателем
      // (trip.ownerId), не любым, кто её просто открыл на редактирование
      // (см. modules/trips/index.js — там та же проверка на UI, но кнопку
      // спрятать не значит запретить: без этого правила любой участник
      // всё ещё мог бы удалить чужую поездку напрямую через API/консоль).
      // update дополнительно запрещает МЕНЯТЬ ownerId на существующей
      // записи — иначе delete выше обходится в два шага (сначала update
      // ownerId на себя, потом delete "своей" поездки). Первое присвоение
      // (миграция старых поездок без ownerId, см. TripsData.backfillOwnerId)
      // остаётся разрешено — сравнение пропускает случай, когда поля ещё
      // не было. Реальная дыра, найдена внешним ревью 2026-09-27.
      // Само-присоединение по ссылке (memberIds раньше не включал меня,
      // теперь включает — сам записываю себя, а не организатор кого-то
      // добавляет) должно уважать "Добавлять людей могу только я" даже
      // при прямом обращении к API в обход клиентского кода —
      // TripsFirebase.addParticipant это уже проверяет транзакцией по
      // токену, но только на уровне приложения; правило дублирует часть
      // этой защиты (без токена — его тут проверить нечем, см. комментарий
      // в TripsFirebase.addParticipant) на уровне базы. Реальная дыра,
      // найдена внешним ревью 2026-09-27.
      function isSelfJoining() {
        return !(request.auth.uid in resource.data.get('memberIds', [])) &&
          request.auth.uid in request.resource.data.get('memberIds', []);
      }
      // isSelfJoining() выше проверяет ТЕКУЩЕЕ (до этой записи) значение
      // inviteRestricted — но ничто раньше не мешало обычному участнику
      // (не владельцу) сначала ОТДЕЛЬНОЙ записью выключить inviteRestricted
      // (это поле никак не было заперто), а вторым шагом уже спокойно
      // присоединить себя, когда ограничение снято. Реальная дыра (обход в
      // два шага, тот же класс, что уже закрыт у ownerId/createdBy),
      // найдена внешним ревью 2026-09-27. Менять inviteRestricted теперь
      // может только владелец поездки или суперадмин — как и полагается
      // настройке, которая управляет тем, кто может себя добавить.
      function isInviteRestrictedChanging() {
        return request.resource.data.get('inviteRestricted', false) != resource.data.get('inviteRestricted', false);
      }
      allow create: if isMember();
      allow update: if isMember() &&
        (resource.data.get('ownerId', null) == null || request.resource.data.ownerId == resource.data.ownerId) &&
        (!isSelfJoining() || resource.data.get('inviteRestricted', false) == false) &&
        (!isInviteRestrictedChanging() || resource.data.get('ownerId', null) == request.auth.uid || isOrganizer());
      allow delete: if isMember() && (resource.data.ownerId == request.auth.uid || isOrganizer());

      // Удалить чужую запись расхода/улова может только организатор ЭТОЙ
      // поездки — свою запись (createdBy == себя) может удалить любой.
      // update дополнительно запрещает менять createdBy — тот же обход в
      // два шага, что и с trip.ownerId выше (подменить автора, потом
      // удалить "свою" запись).
      match /expenses/{docId} {
        allow read, create: if isMember();
        allow update: if isMember() && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember() &&
          (resource.data.createdBy == request.auth.uid || isTripOrganizer(tripId) || isOrganizer());
      }
      match /catches/{docId} {
        allow read, create: if isMember();
        allow update: if isMember() && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember() &&
          (resource.data.createdBy == request.auth.uid || isTripOrganizer(tripId) || isOrganizer());
      }
      // Личная заметка (private: true) реально видна только автору — read
      // и update отфильтрованы по resource.data, а не просто скрыты в UI.
      // Второе условие на update не даёт постороннему молча спрятать ЧУЖУЮ
      // публичную заметку, проставив private:true — поле private может
      // менять только автор, остальные поля (pin/задача/готово) — любой
      // участник, как и раньше.
      // ВАЖНО: обязательно .get('private', false), а не resource.data.private
      // — у заметок, созданных до этой фичи, поля private вообще нет, а
      // прямое обращение к отсутствующему полю кидает ошибку evaluation,
      // из-за которой падает ВЕСЬ realtime-listener списка заметок (не
      // только у одного документа) — воспроизвели это вживую 2026-09-23.
      match /notes/{docId} {
        allow read: if isMember() &&
          (resource.data.get('private', false) != true || resource.data.createdBy == request.auth.uid);
        // request.resource.data.createdBy == resource.data.createdBy — тот
        // же обход в два шага, что уже закрыт у trip.ownerId/expenses/
        // catches.createdBy: без этого условия любой участник мог сперва
        // присвоить себе чужую публичную заметку (createdBy никак не был
        // заперт), а затем удалить её или сделать личной, пройдя проверки
        // "я автор" уже вторым шагом. Реальная дыра, найдена внешним ревью
        // 2026-09-27.
        allow update: if isMember() &&
          (resource.data.get('private', false) != true || resource.data.createdBy == request.auth.uid) &&
          (request.resource.data.get('private', false) == resource.data.get('private', false) || resource.data.createdBy == request.auth.uid) &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow create: if isMember() && request.resource.data.createdBy == request.auth.uid;
        allow delete: if isMember() &&
          (resource.data.createdBy == request.auth.uid || isTripOrganizer(tripId) || isOrganizer());
      }

      // Firestore объединяет правила из ВСЕХ подходящих match-блоков через
      // OR, а не берёт самый специфичный — этот wildcard тоже совпадает с
      // путями expenses/catches/notes, поэтому явно исключаем их отсюда,
      // иначе его allow write перекрывает более узкое правило на delete выше.
      // Лента «Что нового»: читают участники, добавляет участник от своего
      // имени, править нельзя, удалить — только админ.
      // delete: свою запись — сам автор (уйти можно, если заметка, на
      // которую она ссылается, стала приватной/удалена — см.
      // NotesFirebase.removeByNote, — или при полном удалении поездки).
      // Правки чужих действий по-прежнему не пишем — только организатор.
      match /activity/{docId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isMember() && (resource.data.uid == request.auth.uid || isOrganizer());
      }
      // «Мои дела по поездке» — личный список, видит и пишет только владелец.
      match /todo_personal/{uid} {
        allow read, write: if isMember() && request.auth.uid == uid;
      }
      // Личная аптечка — документ на человека: читают все участники (на
      // экстренный случай), пишет только сам владелец или админ.
      match /medkit_personal/{uid} {
        allow read: if isMember();
        allow write: if isMember() && (request.auth.uid == uid || isOrganizer());
      }
      // Личные аптечки живут в medkit_personal/{uid} (правило выше) — в
      // общий документ modules/medkit поле personal больше не пускаем, иначе
      // любой участник по-прежнему мог бы записать туда чужую аптечку.
      match /{subcollection}/{docId} {
        allow read, delete: if isMember() && !(subcollection in ['expenses', 'catches', 'notes', 'medkit_personal', 'activity', 'todo_personal']);
        allow create, update: if isMember() && !(subcollection in ['expenses', 'catches', 'notes', 'medkit_personal', 'activity', 'todo_personal'])
          && !(subcollection == 'modules' && docId == 'medkit' && ('personal' in request.resource.data));
      }
    }

    // Вложенное правило выше (match /trips/{tripId} { match /catches/{docId} })
    // действует только на запросы к конкретной поездке — collectionGroup-
    // запрос по всем catches сразу (см. CatchesFirebase.listenAll, нужен
    // для агрегированной статистики на Главной/в "Планах") требует
    // отдельного рекурсивного правила, иначе Firestore отвечает
    // permission-denied даже при isMember() == true. Запись сюда не нужна —
    // пишут всегда по конкретному пути trips/{tripId}/catches, это уже
    // покрыто правилом выше.
    match /{path=**}/catches/{docId} {
      allow read: if isMember();
    }

    // Очередь пуша "поездка удалена" боту (см. modules/trips/data.js
    // deleteTrip, bot/src/reminders.js checkTripDeletions) — клиент
    // только пишет запись после успешного удаления самой поездки, читает
    // и помечает sent бот через admin SDK (обходит правила, read/update
    // клиенту не нужны вообще).
    match /trip_deletions/{id} {
      allow create: if isMember();
      allow read, update, delete: if false;
    }

    match /menu/{tripId}        { allow read, write: if isMember(); }
    match /shopping/{tripId}    { allow read, write: if isMember(); }
    match /bar_reviews/{id}     { allow read, write: if isMember(); }
    match /recipes_reviews/{id} { allow read, write: if isMember(); }

    // Рецепты, добавленные участниками через интерфейс (помимо встроенного
    // каталога, который зашит прямо в код и не хранится в Firestore) —
    // удалить может только автор. createdBy запрещено менять при update —
    // без этого любой участник мог присвоить себе чужой рецепт (createdBy
    // ничем не был заперт), а затем удалить его, пройдя проверку автора уже
    // вторым шагом — тот же обход, что уже закрыт у заметок/расходов/
    // уловов. Реальная дыра, найдена внешним ревью 2026-09-27.
    match /recipes_custom/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;
    }

    // Бывший встроенный каталог рецептов (modules/recipes/data.js) —
    // теперь тоже в Firestore, редактируется прямо в приложении любым
    // участником (не только автором, тут нет понятия "автор" — это общая
    // книга рецептов, не чей-то личный список). См. RecipesFirebase.
    match /recipes_catalog/{id} {
      allow read, write: if isMember();
    }

    // Каталог ингредиентов — общий справочник "что покупаем" для
    // автодополнения в форме рецепта и резолва категории при пуше в
    // Закупку (см. modules/recipes/firebase.js).
    match /ingredients/{id} {
      allow read, write: if isMember();
    }

    // Порядок/видимость вкладок-категорий книги рецептов — один общий
    // документ (recipes_meta/categories), тот же паттерн, что и остальные
    // общие настройки рецептов выше.
    match /recipes_meta/{id} {
      allow read, write: if isMember();
    }

    // Личные списки снаряги под конкретную поездку — видны всем участникам
    // (как расходы/улов), но создавать/менять/удалять может только владелец.
    // id документа — "{uid}_{tripId}" (см. modules/gear/data.js _docId), но
    // раньше create проверял только поле data.uid, а не сам адрес — чужой
    // участник мог заранее занять АДРЕС настоящего владельца ("{его uid}_
    // {tripId}") документом со СВОИМ data.uid (это create разрешал), и
    // настоящий владелец потом ни разу не мог сохранить туда список: адрес
    // уже занят, а update требует resource.data.uid == себя, что подставная
    // запись не даёт. Реальная дыра, найдена внешним ревью 2026-09-27. id
    // теперь обязан НАЧИНАТЬСЯ с uid создателя — свой адрес себе только.
    match /gear_trip_snapshots/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid &&
        id.matches(request.auth.uid + '_.*');
      allow update, delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Общий (групповой) список снаряги на поездку — один документ на
    // поездку (id = tripId), в отличие от личных списков выше. Правит
    // любой участник, как Меню/Закупки — это совместный список, а не
    // персональный.
    match /gear_trip_shared/{tripId} {
      allow read, write: if isMember();
    }

    // Личный список покупок на поездку — в отличие от gear_trip_snapshots
    // выше, НЕ виден остальным участникам вообще (не "личное, но видно
    // всем", а по-настоящему приватное — свои носки/энергетики/новый
    // спиннинг никого не касаются). uid прямо в пути, а не в поле
    // документа — так isMember() тут даже не нужен, только владелец.
    match /personal_purchases/{uid}/trips/{tripId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
