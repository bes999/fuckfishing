rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isOrganizer() {
      return isMember() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'organizer';
    }

    // Разрешено пройти онбординг, только если email из Firebase Auth
    // токена уже есть в аллоулисте /invites — заполняется существующими
    // участниками через "Пригласить" (modules/members/render.js).
    function isInvited() {
      return isSignedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    // Организатор КОНКРЕТНОЙ поездки (её создатель, trip.ownerId) — не
    // путать с isOrganizer() выше, это app-wide profile.role, другое поле
    // с другим смыслом (см. modules/auth/index.js).
    function isTripOrganizer(tripId) {
      return isMember() &&
        get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
    }

    match /members/{uid} {
      // Читать список нужно даже до онбординга — completeOnboarding()
      // (modules/auth/index.js) проверяет "я первый пользователь?" ДО
      // того как свой профиль создан.
      allow read:   if isMember() || isInvited();
      allow create: if isSignedIn() && request.auth.uid == uid && isInvited();
      allow update: if isMember() && (request.auth.uid == uid || isOrganizer());
      allow delete: if isMember() && isOrganizer();
    }

    match /invites/{email} {
      allow read:            if isMember();
      allow create, delete:  if isMember();
      allow update:          if false;
    }

    match /trips/{tripId} {
      allow read, write: if isMember();

      // Удалить чужую запись расхода/улова может только организатор ЭТОЙ
      // поездки — свою запись (createdBy == себя) может удалить любой.
      // Редактирование/чтение остаются открытыми всем участникам, как и
      // раньше — здесь закрывается только delete.
      match /expenses/{docId} {
        allow read, create, update: if isMember();
        allow delete: if isMember() &&
          (resource.data.createdBy == request.auth.uid || isTripOrganizer(tripId));
      }
      match /catches/{docId} {
        allow read, create, update: if isMember();
        allow delete: if isMember() &&
          (resource.data.createdBy == request.auth.uid || isTripOrganizer(tripId));
      }

      // Firestore объединяет правила из ВСЕХ подходящих match-блоков через
      // OR, а не берёт самый специфичный — этот wildcard тоже совпадает с
      // путями expenses/catches, поэтому явно исключаем их отсюда, иначе
      // его allow write перекрывает более узкое правило на delete выше.
      match /{subcollection}/{docId} {
        allow read, write: if isMember() && !(subcollection in ['expenses', 'catches']);
      }
    }

    match /menu/{tripId}        { allow read, write: if isMember(); }
    match /shopping/{tripId}    { allow read, write: if isMember(); }
    match /bar_reviews/{id}     { allow read, write: if isMember(); }
    match /recipes_reviews/{id} { allow read, write: if isMember(); }

    match /{document=**} { allow read, write: if false; }
  }
}
